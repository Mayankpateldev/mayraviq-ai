# Local development only. Production must use OIDC and NODE_ENV=production.
NODE_ENV=development
API_HOST=127.0.0.1
PORT=4000
APP_ORIGIN=http://127.0.0.1:5174
DATABASE_URL=postgresql://mayraviq:REPLACE_LOCAL_PASSWORD@127.0.0.1:5432/mayraviq
DEV_AUTH=true
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_REQUIRED_GROUP=
OIDC_GROUP_CLAIM=groups
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional private AI drafting; disabled until explicitly configured.
AI_ENABLED=false
AI_ENDPOINT=http://ollama:11434
AI_MODEL=llama3.2:3b
