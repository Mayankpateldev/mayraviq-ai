{
  "name": "mayraviq",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @mayraviq/web",
    "dev:api": "npm run dev -w @mayraviq/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build -w @mayraviq/web",
    "build:api": "npm run build -w @mayraviq/api",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.tools.json",
    "test": "node --import tsx --test tests/unit/*.mjs tests/integration/*.mjs",
    "db:migrate": "npm run db:migrate -w @mayraviq/api",
    "db:import-legacy": "npm run db:import-legacy -w @mayraviq/api",
    "dev:embedded": "node --import tsx scripts/dev-embedded.ts",
    "lint": "eslint apps packages scripts tests --max-warnings 0",
    "format:check": "prettier --check apps packages scripts tests docs infra *.json *.yaml *.md eslint.config.mjs .github/workflows",
    "dev:call": "node --import tsx scripts/dev-call.ts",
    "dev:local": "node --env-file-if-exists=.env.local --import tsx scripts/dev-call.ts",
    "ai:verify": "node --import tsx scripts/verify-ai.ts",
    "backup:local": "node --import tsx scripts/backup-local.ts",
    "restore:local": "node --import tsx scripts/restore-local.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1",
    "@eslint/js": "9.39.4",
    "prettier": "^3.9.9"
  }
}
