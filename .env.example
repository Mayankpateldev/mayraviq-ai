# Compose production deployment: supply actual values outside source control.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DATABASE_URL=postgresql://mayraviq:REPLACE_WITH_RANDOM_PASSWORD@db:5432/mayraviq
APP_ORIGIN=https://mayraviq.example.internal
OIDC_ISSUER=https://identity.example.internal
OIDC_AUDIENCE=mayraviq-api
OIDC_JWKS_URL=https://identity.example.internal/.well-known/jwks.json
OIDC_CLIENT_ID=REPLACE_WITH_PUBLIC_SPA_CLIENT_ID
OIDC_SCOPE=openid profile email
OIDC_REQUIRED_GROUP=mayraviq-team
OIDC_GROUP_CLAIM=groups
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional private AI drafting; disabled until explicitly configured.
AI_ENABLED=false
AI_ENDPOINT=http://ollama:11434
AI_MODEL=llama3.2:3b

# Optional API-only invitation email; disabled unless configured.
MAIL_MODE=disabled
MAIL_OUTBOX_KEY=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
